APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string

# local | firestore
DATA_ADAPTER=local
DATA_DIR=.data

BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_NAME=Local Admin

# Required when DATA_ADAPTER=firestore or Firebase Auth verify
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Frontend web config (also set in frontend/.env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

AUTH_ALLOWED_DOMAINS=
AUTH_OPEN_SIGNUP=false
AUTH_DEFAULT_ROLE=VIEWER
ALLOW_PASSWORD_LOGIN=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=ContractOS <contracts@amplifymediatechnologies.com>
