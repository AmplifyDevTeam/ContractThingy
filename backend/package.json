{
  "name": "amplify-contractos-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:vercel",
    "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --target=node20 --format=cjs --alias:@=./src --outfile=api/index.js --external:playwright --external:playwright-core",
    "start": "tsx src/index.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.19.0",
    "@opentelemetry/api": "^1.9.0",
    "date-fns": "^4.4.0",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.4.0",
    "hono": "^4.9.0",
    "jose": "^6.2.12",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
