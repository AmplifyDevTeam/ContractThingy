# Backend (Vercel project B) + free Firebase
APP_URL=https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app
SESSION_SECRET=replace-with-a-long-random-string

DATA_ADAPTER=firestore
FIREBASE_PROJECT_ID=amplify-contractos
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional — not required. PDFs/signatures are stored in Firestore on the free Spark plan.
FIREBASE_STORAGE_BUCKET=

# Firebase Auth signup policy (production defaults: invite-only)
# First user in an empty workspace → SUPER_ADMIN.
# Then: AUTH_ALLOWED_DOMAINS=company.com and/or invite in Settings → Users.
# AUTH_OPEN_SIGNUP=true allows any Firebase user (unsafe on public URLs).
AUTH_ALLOWED_DOMAINS=
AUTH_OPEN_SIGNUP=false
AUTH_DEFAULT_ROLE=VIEWER

# Password login: on by default in development; off in production unless true
ALLOW_PASSWORD_LOGIN=

# Optional local password bootstrap (dev only). Prefer Google in production.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# Optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required in production for signing emails and client OTP codes
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=ContractOS <contracts@amplifymediatechnologies.com>

# Shared with the frontend: lets the API trust the signer IP/UA forwarded by Next.js server actions
PROXY_SHARED_SECRET=
# Optional: @sparticuz/chromium pack URL when Vercel does not bundle the Chromium binary
CHROMIUM_PACK_URL=
# Optional (local): use a specific Chrome/Chromium binary for PDFs
CHROMIUM_EXECUTABLE_PATH=
